# GitHub OAuth App credentials. Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DeepSeek server-side credentials. Never expose this key to browser code.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Emergency switch: false disables paid AI while retaining local narration and saves.
AI_ENABLED=true
MODEL_DAILY_CALL_LIMIT=50
MODEL_MONTHLY_CALL_LIMIT=500

# Server-only hashed invitation definitions. Empty/malformed means fail closed.
# Generate with scripts/create-invites.mjs; never put raw codes in the frontend or repository.
INVITE_CODES_JSON=[]
