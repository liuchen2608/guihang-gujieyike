# GitHub OAuth App credentials. Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DeepSeek server-side credentials. Never expose this key to browser code.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# false disables paid AI; existing configured global limits remain authoritative.
AI_ENABLED=true
# Leave empty unless the gateway overwrites this header and direct access is blocked.
TRUSTED_CLIENT_IP_HEADER=

# Project-scoped TOS credentials. The bucket must be private and versioning OFF.
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_PREFIX=guihang/

# Trial ceilings, NOT a provider billing hard cap. Zero disables model calls.
MODEL_MONTHLY_CALL_LIMIT=1000
MODEL_DAILY_CALL_LIMIT=100
